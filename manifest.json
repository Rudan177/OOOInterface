{
  "manifest_version": 3,
  "name": "OOOInterface",
  "version": "5.3.33",
  "description": "RUDAN开发的浏览器首页插件。",
  "chrome_url_overrides": {
    "newtab": "main/index.html"
  },
  "side_panel": {
    "default_path": "main/sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "main/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "main/content-shortcut.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://rudan177.github.io/OOOInterface/try/*"
      ],
      "js": [
        "main/content-storage-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://rudan177.github.io/OOOInterface/try/*"
      ],
      "js": [
        "main/content-storage-relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "builtin_open_frame",
        "enabled": true,
        "path": "main/rules.json"
      }
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; font-src 'self' https: data:; style-src 'self' https://fonts.googleapis.com 'unsafe-inline';"
  },
  "host_permissions": [
    "<all_urls>",
    "https://www.bing.com/*",
    "https://*.bing.net/*",
    "https://suggestqueries.google.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://www.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://rudan177.github.io/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "bookmarks",
    "geolocation",
    "identity",
    "sidePanel",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "commands": {
    "activate-ooointerface": {
      "suggested_key": {
        "default": "Alt+O"
      },
      "description": "切换 OOOInterface 侧边栏（侧边栏功能关闭时打开主页）"
    },
    "add-current-page": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "把当前网页添加到快速访问链接（面板打开时快速编辑链接）"
    }
  },

  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    },
    "default_title": "OOOInterface"
  }
}