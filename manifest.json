{
  "manifest_version": 3,
  "name": "OOOInterface",
  "version": "5.2.02",
  "description": "RUDAN开发的浏览器首页插件。长期支持版 5.2.02:25.2-RS120.2",
  "chrome_url_overrides": {
    "newtab": "main/index.html"
  },
  "host_permissions": [
    "https://www.bing.com/*",
    "https://*.bing.net/*"
  ],
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    },
    "default_title": "OOOInterface"
  }
}