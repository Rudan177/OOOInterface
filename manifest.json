{
  "manifest_version": 3,
  "name": "OOOInterface",
  "version": "5.3.31",
  "description": "RUDAN开发的浏览器首页插件。",
  "chrome_url_overrides": {
    "newtab": "main/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; font-src 'self' https: data:; style-src 'self' https://fonts.googleapis.com 'unsafe-inline';"
  },
  "host_permissions": [
    "https://www.bing.com/*",
    "https://*.bing.net/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://www.googleapis.com/*",
    "https://accounts.google.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "bookmarks",
    "geolocation",
    "identity"
  ],

  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    },
    "default_title": "OOOInterface"
  }
}